## Copy this file to .env and fill in your own paths.
## .env is gitignored -- it's machine-specific, not project config.

# Required. Wonderful Toolchain install root (the directory containing
# bin/, toolchain/, target/). See CLAUDE.md's "Build environment" section.
WONDERFUL_TOOLCHAIN=C:/path/to/wonderful

# Only needed instead of WONDERFUL_TOOLCHAIN if you're building with
# devkitARM (see tools/butano/butano/butano.mak's toolchain autodetection).
# DEVKITARM=C:/path/to/devkitPro/devkitARM
